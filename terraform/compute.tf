data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"] # Canonical
  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"]
  }
}

# Controller-to-agent SSH key pair, generated by Terraform.
# Private key -> goes into Jenkins as "SSH Username with private key" credential.
# Public key  -> goes into the agent's ~jenkins/.ssh/authorized_keys.
resource "tls_private_key" "agent_ssh" {
  algorithm = "ED25519"
}

resource "aws_instance" "controller" {
  ami                    = data.aws_ami.ubuntu.id
  instance_type          = var.controller_instance_type
  subnet_id              = aws_subnet.public.id
  vpc_security_group_ids = [aws_security_group.controller.id]
  key_name               = var.key_name
  iam_instance_profile   = aws_iam_instance_profile.controller.name

  root_block_device {
    volume_size = 20
    volume_type = "gp3"
    encrypted   = true
  }

  user_data = templatefile("${path.module}/scripts/controller.sh", {
    backup_bucket = aws_s3_bucket.backup.bucket
  })

  tags = { Name = "jenkins-controller" }
}

resource "aws_instance" "agent" {
  count                  = var.agent_count
  ami                    = data.aws_ami.ubuntu.id
  instance_type          = var.agent_instance_type
  subnet_id              = aws_subnet.private.id
  vpc_security_group_ids = [aws_security_group.agent.id]
  key_name               = var.key_name

  root_block_device {
    volume_size = 12
    volume_type = "gp3"
    encrypted   = true
  }

  # Separate EBS volume for /home/jenkins (agent root + workspaces), so a full
  # workspace disk can't fill the OS disk. (Concept from Q1 follow-up.)
  ebs_block_device {
    device_name = "/dev/sdf"
    volume_size = 20
    volume_type = "gp3"
    encrypted   = true
  }

  user_data = templatefile("${path.module}/scripts/agent.sh", {
    controller_pubkey = tls_private_key.agent_ssh.public_key_openssh
  })

  depends_on = [aws_nat_gateway.nat]

  tags = { Name = "jenkins-agent-${count.index + 1}" }
}
